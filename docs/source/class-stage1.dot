  }
  subgraph cluster_5 { label=<<I>package restaurantrush.model.customer</I>>; fontsize=12; style="rounded,dashed"; color="#8a8a8a"; fontcolor="#555555";
    Customer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#dbe7f5"><FONT POINT-SIZE="10">«entity, abstract»</FONT><BR/><I><B>Customer</B></I></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: int {readOnly}<BR ALIGN="LEFT"/>- arrivalTurn: int {readOnly}<BR ALIGN="LEFT"/>- satisfaction: int<BR ALIGN="LEFT"/>- servedTurn: int<BR ALIGN="LEFT"/>- readyToPayTurn: int<BR ALIGN="LEFT"/>- recordedSatisfaction: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ getTypeName(): String</I><BR ALIGN="LEFT"/><I>+ getSatisfactionLossPerTurn(): int</I><BR ALIGN="LEFT"/>+ chooseFood(menu: Menu): MenuItem<BR ALIGN="LEFT"/>+ whyNotSeat(): String<BR ALIGN="LEFT"/>+ whyNotOrder(): String<BR ALIGN="LEFT"/>+ whyNotServe(): String<BR ALIGN="LEFT"/>+ whyNotPay(turn: int): String<BR ALIGN="LEFT"/>+ canBeSeated(): boolean<BR ALIGN="LEFT"/>+ canOrder(): boolean<BR ALIGN="LEFT"/>+ canBeServed(): boolean<BR ALIGN="LEFT"/>+ canPay(turn: int): boolean<BR ALIGN="LEFT"/>+ seat(turn: int)<BR ALIGN="LEFT"/>+ placeOrder(menu: Menu, turn: int): Order<BR ALIGN="LEFT"/>+ serve(turn: int)<BR ALIGN="LEFT"/>+ finishEating(turn: int): boolean<BR ALIGN="LEFT"/>+ pay(turn: int): int<BR ALIGN="LEFT"/>+ endOfTurn(turn: int): boolean<BR ALIGN="LEFT"/>- check(reason: String)<BR ALIGN="LEFT"/>+ hasBeenServed(): boolean<BR ALIGN="LEFT"/>+ hasPaid(): boolean<BR ALIGN="LEFT"/>+ hasLeftUnhappy(): boolean<BR ALIGN="LEFT"/>+ label(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
