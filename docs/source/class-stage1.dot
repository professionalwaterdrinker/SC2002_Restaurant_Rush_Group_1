  note0 [shape=note, style=filled, fillcolor="#fff8c6", color="#b59b00", fontsize=10, margin="0.12,0.08", label=<<B>ENCAPSULATION</B><BR ALIGN="LEFT"/>actedThisTurn is private and is set only<BR ALIGN="LEFT"/>inside perform(), which is final. No subclass<BR ALIGN="LEFT"/>can bypass 'at most one task per turn', and<BR ALIGN="LEFT"/>a refused task never uses up the turn.<BR ALIGN="LEFT"/>>];
  note0 -> Staff [style=dashed, arrowhead=none, color="#b59b00", penwidth=1.3, weight=3];
  note1 [shape=note, style=filled, fillcolor="#fff8c6", color="#b59b00", fontsize=10, margin="0.12,0.08", label=<<B>ENCAPSULATION</B><BR ALIGN="LEFT"/>satisfaction, status and order are private.<BR ALIGN="LEFT"/>They change only through seat(), placeOrder(),<BR ALIGN="LEFT"/>serve(), finishEating(), pay() and endOfTurn(),<BR ALIGN="LEFT"/>each guarded by a whyNot...() check.<BR ALIGN="LEFT"/>>];
  note1 -> Customer [style=dashed, arrowhead=none, color="#b59b00", penwidth=1.3, weight=3];
  note2 [shape=note, style=filled, fillcolor="#fff8c6", color="#b59b00", fontsize=10, margin="0.12,0.08", label=<<B>POLYMORPHISM (ready for Stage 2)</B><BR ALIGN="LEFT"/>Staff, roster and controller call<BR ALIGN="LEFT"/>getSatisfactionLossPerTurn() and chooseFood()<BR ALIGN="LEFT"/>through the abstract Customer type.<BR ALIGN="LEFT"/>>];
  note2 -> RegularCustomer [style=dashed, arrowhead=none, color="#b59b00", penwidth=1.3, weight=3];
  note3 [shape=note, style=filled, fillcolor="#fff8c6", color="#b59b00", fontsize=10, margin="0.12,0.08", label=<<B>COMPOSITION</B><BR ALIGN="LEFT"/>Restaurant creates and owns its<BR ALIGN="LEFT"/>Tables, WaitingQueue and CustomerRoster<BR ALIGN="LEFT"/>in its constructor; they do not exist outside it.<BR ALIGN="LEFT"/>>];
  note3 -> Restaurant [style=dashed, arrowhead=none, color="#b59b00", penwidth=1.3, weight=3];
  legend [fontsize=10, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#eeeeee"><B>Legend</B></TD></TR><TR><TD ALIGN="LEFT">+  -  #  ~</TD><TD ALIGN="LEFT">public, private, protected, package</TD></TR><TR><TD ALIGN="LEFT"><I>italic</I></TD><TD ALIGN="LEFT">abstract class or operation</TD></TR><TR><TD ALIGN="LEFT"><U>underlined</U></TD><TD ALIGN="LEFT">static</TD></TR><TR><TD ALIGN="LEFT">&#9671;&#8212;&gt;</TD><TD ALIGN="LEFT">aggregation</TD></TR><TR><TD ALIGN="LEFT">&#9670;&#8212;&gt;</TD><TD ALIGN="LEFT">composition (owner creates the part)</TD></TR><TR><TD ALIGN="LEFT">&#8212;&#9655;</TD><TD ALIGN="LEFT">inheritance</TD></TR><TR><TD ALIGN="LEFT">- - -&gt;</TD><TD ALIGN="LEFT">dependency (uses / creates)</TD></TR><TR><TD ALIGN="LEFT">omitted</TD><TD ALIGN="LEFT">constructors, toString() and plain getters</TD></TR></TABLE>>];
}
