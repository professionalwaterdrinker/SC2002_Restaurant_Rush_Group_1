    Restaurant [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#dbe7f5"><FONT POINT-SIZE="10">«entity»</FONT><BR/><B>Restaurant</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- totalRevenueCents: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getTable(tableNumber: int): Table<BR ALIGN="LEFT"/>+ getFirstFreeTable(): Table<BR ALIGN="LEFT"/>+ addArrival(customer: Customer)<BR ALIGN="LEFT"/>+ addRevenue(cents: int)<BR ALIGN="LEFT"/>+ findTableWithCustomer(customer: Customer): Table<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
